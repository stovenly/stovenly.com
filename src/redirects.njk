---
pagination:
  data: redirects
  size: 1
  alias: redirect
permalink: "{{ redirect.from }}"
eleventyExcludeFromCollections: true
redirects:
  - { from: /poems/, to: /writing/ }
  - { from: /stories/, to: /writing/ }
  - { from: /games/, to: /projects/ }
  - { from: /games/codenames/, to: /projects/codenames/ }
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content="0; url={{ redirect.to }}">
  <link rel="canonical" href="https://stovenly.com{{ redirect.to }}">
  <meta name="robots" content="noindex">
  <title>Moved</title>
</head>
<body>
  <a href="{{ redirect.to }}">Moved here</a>
</body>
</html>
