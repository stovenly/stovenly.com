{# Full-screen viewer for .game-gallery. Hooks on ids and data-* only —
   util/minify.js renames class names in docs/. #}
<dialog id="viewer" class="viewer">
  <button type="button" id="viewer-close" class="viewer-close" aria-label="Close">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <button type="button" id="viewer-prev" class="viewer-nav viewer-prev" aria-label="Previous">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
  </button>
  <button type="button" id="viewer-next" class="viewer-nav viewer-next" aria-label="Next">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
  </button>
  <div id="viewer-stage" class="viewer-stage"></div>
</dialog>
<script>
  (function () {
    var gallery = document.getElementById("gallery");
    var viewer = document.getElementById("viewer");
    var stage = document.getElementById("viewer-stage");
    var items = Array.prototype.slice.call(gallery.querySelectorAll("[data-image],[data-video]"));
    var index = 0;

    function show(i) {
      index = (i + items.length) % items.length;
      var el = items[index];
      stage.textContent = "";
      var node;
      if (el.dataset.video) {
        node = document.createElement("video");
        node.src = el.dataset.video;
        node.controls = true;
        node.autoplay = true;
        node.playsInline = true;
      } else {
        node = document.createElement("img");
        node.src = el.dataset.image;
        node.alt = "";
      }
      stage.appendChild(node);
    }

    function open(i) {
      show(i);
      viewer.showModal();
    }

    items.forEach(function (el, i) {
      el.addEventListener("click", function () { open(i); });
    });

    document.getElementById("viewer-close").addEventListener("click", function () { viewer.close(); });
    document.getElementById("viewer-prev").addEventListener("click", function () { show(index - 1); });
    document.getElementById("viewer-next").addEventListener("click", function () { show(index + 1); });

    viewer.addEventListener("click", function (e) {
      if (e.target === viewer || e.target === stage) viewer.close();
    });
    viewer.addEventListener("close", function () { stage.textContent = ""; });
    viewer.addEventListener("keydown", function (e) {
      if (e.key === "ArrowLeft") show(index - 1);
      else if (e.key === "ArrowRight") show(index + 1);
    });
  })();
</script>
