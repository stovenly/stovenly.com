<!DOCTYPE html>
<html lang="en">
<head>
  {% include "analytics.njk" %}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {# Must stay above the stylesheet link — see the note in theme.njk. #}
  {% include "theme.njk" %}
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="stylesheet" href="/css/style.css">
  <title>{{ title | default("stovenly") }}</title>
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/" class="site-name">stovenly</a>
      <nav>
        <a href="/poems/">Poems</a>
        <a href="/stories/">Stories</a>
        <button type="button" id="menu-trigger" class="menu-trigger"
                popovertarget="site-menu" aria-label="Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18"/>
          </svg>
        </button>
      </nav>
    </div>
  </header>
  {# General-purpose overflow menu. Add further .menu-row entries as needed. #}
  <div id="site-menu" class="menu-popover" popover>
    <label class="menu-row">
      <span class="menu-label">Theme</span>
      <input type="checkbox" role="switch" class="switch-input" data-theme-switch>
      <span class="switch" aria-hidden="true">
        <svg class="switch-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.5" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.5"/>
          <path d="M12 1.5v2M12 20.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1.5 12h2M20.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/>
        </svg>
        <svg class="switch-moon" viewBox="0 0 24 24" fill="currentColor" stroke="none">
          <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/>
        </svg>
      </span>
    </label>
  </div>
  <main class="scroll-area">
    <div class="container">
      {{ content | safe }}
    </div>
  </main>
  {% include "theme-menu.njk" %}
</body>
</html>
